=\"white\" stop-opacity=\"0.01\"/> <stop offset=\"1\" stop-color=\"white\" stop-opacity=\"0.1\"/> </linearGradient> </defs> </svg>`;\n\nconst toMask = (svg: string) => `url(\"data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}\")`;\nconst masked = (src: string): CSSProperties => ({ WebkitMaskImage: src, maskImage: src });\n\nconst DOTS_SRC = toMask(DOTS_SVG);\nconst DEVICE_SRC = toMask(DEVICE_SVG);\nconst KEYBOARD_SRC = toMask(KEYBOARD_SVG);\n\nconst STYLES = `\n.mei, .mei *, .mei *::before, .mei *::after { box-sizing: border-box; }\n.mei { position: relative; width: 100%; height: 100%; min-width: 0; min-height: 0; overflow: hidden; color: hsl(var(--foreground)); background: var(--mei-bg, hsl(var(--background))); font-family: var(--font-body), ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; container-type: size; isolation: isolate; display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: clamp(12px, 4cqw, 56px); padding: clamp(20px, 7cqh, 64px) clamp(20px, 7cqw, 88px); text-align: left; }\n.mei::before { position: absolute; inset: 0; z-index: -1; content: \"\"; background-image: linear-gradient(hsl(var(--border) / 0.6) 1px, transparent 1px); background-size: 100% clamp(24px, 8cqh, 48px); -webkit-mask-image: linear-gradient(90deg, transparent, black 30%, black 70%, transparent); mask-image: linear-gradient(90deg, transparent, black 30%, black 70%, transparent); opacity: 0.5; }\n.mei-label { display: inline-flex; align-items: center; gap: 10px; margin-bottom: clamp(8px, 3cqh, 24px); color: hsl(var(--muted-foreground)); font-family: var(--font-mono, ui-monospace), ui-monospace, monospace; font-size: clamp(9px, 1.2cqw, 12px); letter-spacing: 0.2em; text-transform: uppercase; }\n.mei-label__dot { width: 7px; height: 7px; border-radius: 50%; background: hsl(var(--primary)); box-shadow: 0 0 0 0 hsl(var(--primary) / 0.5); animation: mei-pulse 2.4s ease-out infinite; }\n@keyframes mei-pulse { 0% { box-shadow: 0 0 0 0 hsl(var(--primary) / 0.45); } 70%, 100% { box-shadow: 0 0 0 8px hsl(var(--primary) / 0); } }\n.mei-graphic { position: relative; justify-self: center; width: min(70cqh, 38cqw, 440px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 50% 45%, hsl(var(--primary) / 0.14), transparent 65%); }\n.mei-graphic::after { position: absolute; inset: -4%; border: 1px dashed hsl(var(--border)); border-radius: 50%; content: \"\"; }\n.mei-dots, .mei-device, .mei-device > span:first-child { position: absolute; inset: 0; width: 100%; height: 100%; }\n.mei-ink { display: block; background: hsl(var(--foreground)); -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }\n.mei-dots { background: hsl(var(--primary)); animation: mei-dots-drift 8s ease-in-out infinite alternate; }\n.mei-device { animation: mei-device-float 6s ease-in-out infinite; }\n.mei-keyboard { position: absolute; top: 59.6%; left: 50%; width: 40.2%; aspect-ratio: 148 / 17; transform: translateX(-50%); }\n.mei-copy { position: relative; z-index: 2; }\n.mei-copy h2 { margin: 0; font-family: var(--font-heading), ui-serif, Georgia, serif; font-size: clamp(24px, 7.2cqw, 92px); font-weight: 500; letter-spacing: -0.03em; line-height: 0.98; }\n.mei-copy h2 em { color: hsl(var(--primary)); font-style: italic; }\n.mei-copy p { max-width: 34ch; margin: clamp(8px, 3.6cqh, 28px) 0 0; padding-top: clamp(8px, 2.4cqh, 20px); border-top: 1px solid hsl(var(--border)); color: hsl(var(--muted-foreground)); font-size: clamp(10px, 1.7cqw, 20px); line-height: 1.5; }\n@keyframes mei-device-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }\n@keyframes mei-dots-drift { from { transform: rotate(-0.4deg) scale(0.995); } to { transform: rotate(0.5deg) scale(1.008); } }\n@container (max-width: 560px) { .mei { grid-template-columns: 1fr; text-align: center; } .mei-graphic { order: -1; width: min(42cqh, 60cqw); } .mei-copy p { margin-inline: auto; } }\n.mei[data-still] *, .mei[data-still] *::before, .mei[data-still] *::after { animation: none !important; transition: none !important; }\n`;\n\nexport interface FolioOpeningProps {\n  label?: string;\n  title?: string;\n  description?: string;\n  backgroundColor?: string;\n  className?: string;\n  style?: CSSProperties;\n}\n\nexport function FolioOpening({\n  label = \"Chapter one\",\n  title = \"Quiet tools, *loud* work.\",\n  description = \"An interface set like a good page: calm margins, clear type and nothing between you and the next idea.\",\n  backgroundColor,\n  className,\n  style,\n}: FolioOpeningProps) {\n  const prefersReducedMotion = useReducedMotion();\n\n  return (\n    <section\n      className={cn(\"mei\", className)}\n      data-still={prefersReducedMotion ? \"\" : undefined}\n      style={backgroundColor ? { ...style, [\"--mei-bg\" as string]: backgroundColor } : style}\n    >\n      <style dangerouslySetInnerHTML={{ __html: STYLES }} />\n      <div className=\"mei-copy\">\n        <span className=\"mei-label\">\n          <span className=\"mei-label__dot\" aria-hidden=\"true\" />\n          {label}\n        </span>\n        <h2>\n          {title.split(\"*\").map((part, i) => (i % 2 ? <em key={i}>{part}</em> : part))}\n        </h2>\n        <p>{description}</p>\n      </div>\n      <div className=\"mei-graphic\" aria-hidden=\"true\">\n        <span className=\"mei-ink mei-dots\" style={masked(DOTS_SRC)} />\n        <div className=\"mei-device\">\n          <span className=\"mei-ink\" style={masked(DEVICE_SRC)} />\n          <span className=\"mei-ink mei-keyboard\" style={masked(KEYBOARD_SRC)} />\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
  ]
}